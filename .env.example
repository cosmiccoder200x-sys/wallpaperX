# Wallpaper10 Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wallpaper10

# Supabase (for auth and storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
MAX_UPLOAD_SIZE_MB=50
MAX_OUTPUT_SIZE_MB=10
MAX_PIXELS=8294400

# Free Plan Limits
FREE_DAILY_OPTIMIZATIONS=5
FREE_MAX_INPUT_MB=25
FREE_MAX_OUTPUT_MB=10

# Pro Plan Limits
PRO_MAX_INPUT_MB=100
PRO_MAX_OUTPUT_MB=50

# Storage
STORAGE_BUCKET=wallpapers
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=100

# URL Fetching
URL_TIMEOUT=10
URL_MAX_SIZE_MB=50
URL_MAX_REDIRECTS=5

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENV=development